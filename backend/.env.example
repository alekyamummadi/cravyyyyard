# 1. Port the server will listen on
PORT=5000

# 2. Environment mode (development or production)
NODE_ENV=development

# 3. Your database connection string
# (If local MongoDB):
MONGODB_URI=mongodb://127.0.0.1:27017/restaurant_platform
# (Or if MongoDB Atlas):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/restaurant_platform?retryWrites=true&w=majority

# 4. JWT Secret Key (used to securely sign user login tokens)
JWT_SECRET=my_custom_super_secret_key_at_least_32_characters_long

# 5. Token expiry duration
JWT_EXPIRES_IN=7d